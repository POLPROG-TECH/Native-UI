{
  "name": "@polprog/storybook",
  "version": "0.0.0",
  "private": true,
  "description": "Design system documentation portal for @polprog/native-ui",
  "scripts": {
    "stats": "node scripts/generate-stats.mjs",
    "scan-usage": "node scripts/scan-usage.mjs && prettier --write docs/data/production-usage.json",
    "dev": "npm run stats && storybook dev -p 6006",
    "storybook": "npm run stats && storybook dev -p 6006",
    "build": "npm run stats && storybook build -o storybook-static",
    "build-storybook": "npm run stats && storybook build -o storybook-static",
    "bundle-size": "node scripts/check-bundle-size.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "serve": "npx serve storybook-static -p 6006",
    "test": "vitest run --project=storybook",
    "test:themes": "node scripts/test-themes.mjs",
    "test:watch": "vitest --project=storybook",
    "chromatic": "npx chromatic --project-token=${CHROMATIC_PROJECT_TOKEN}"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/icons": "^2.2.0",
    "@storybook/react": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "chromatic": "^18.9.4",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native-web": "^0.21.4",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.5",
    "storybook-addon-tag-badges": "^3.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@polprog/native-ui": "*"
  }
}
