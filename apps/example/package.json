{
  "name": "@polprog/example",
  "version": "0.0.0",
  "private": true,
  "description": "Expo app that renders @polprog/native-ui on iOS and Android, for device checks and Maestro flows",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --skip-dependency-update expo,react,react-native",
    "ios": "npm run prebuild -- --platform ios && expo run:ios",
    "android": "npm run prebuild -- --platform android && expo run:android",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "maestro test .maestro"
  },
  "dependencies": {
    "@polprog/native-ui": "*",
    "expo": "~58.0.26",
    "react": "19.3.1",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react-native-reanimated": "^4.8.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-worklets": "^0.14.0",
    "typescript": "^6.0.3"
  }
}
